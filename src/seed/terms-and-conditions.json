          ],
          "direction": "ltr"
        },
        {
          "tag": "ol",
          "type": "list",
          "start": 1,
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "listitem",
              "value": 1,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Orders through mxbeats.com can be placed 24 hours a day, 7 days a week.",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "value": 2,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "To place an order, the Customer selects the product (MXGrid license), provides necessary billing details, selects the payment method, and confirms the purchase by clicking the order placement button (\"Buy Now\", \"Order with Obligation to Pay\", or equivalent).",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "value": 3,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "The contract is concluded upon confirmation of the order and payment processing by StartUp or its authorized payment gateway providers (e.g., Lemon Squeezy).",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "value": 4,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Delivery: MXGrid digital content (download links and/or license keys) is delivered electronically to the email address provided by the Customer immediately after payment confirmation.",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            }
          ],
          "listType": "number",
          "direction": "ltr"
        },
        {
          "tag": "h3",
          "type": "heading",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "§ 5 Software License (EULA) & Update Policy",
              "type": "text",
              "version": 1
            }
          ],
          "direction": "ltr"
        },
        {
          "tag": "ol",
          "type": "list",
          "start": 1,
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "listitem",
              "value": 1,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Grant of License: All software purchased from the Service is subject to our End User License Agreement (EULA). The standard license grants a non-exclusive, non-transferable single-user license to install and use MXGrid on compatible devices.",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "value": 2,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Updates & Versioning:",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            }
          ],
          "listType": "number",
          "direction": "ltr"
        },
        {
          "tag": "ul",
          "type": "list",
          "start": 1,
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "listitem",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Purchases include free updates for all minor versions within the major release branch purchased (e.g., all v1.x.x updates up to v1.99.99).",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Major Upgrades (e.g., upgrading from v1.x.x to v2.0.0) are excluded from free updates and may be offered as separate paid upgrades.",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            }
          ],
          "listType": "bullet",
          "direction": "ltr"
        },
        {
          "tag": "ol",
          "type": "list",
          "start": 3,
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "listitem",
              "value": 3,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "License Consolidation: If a Customer purchases multiple licenses for the same product, the features or activations of these licenses may be consolidated into a single master license associated with the user's account or email.",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            }
          ],
          "listType": "number",
          "direction": "ltr"
        },
        {
          "tag": "h3",
          "type": "heading",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "§ 6 Prices and Payment Methods",
              "type": "text",
              "version": 1
