          "direction": "ltr"
        },
        {
          "tag": "ol",
          "type": "list",
          "start": 1,
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "listitem",
              "value": 1,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Prices displayed on mxbeats.com include applicable local taxes (e.g., VAT).",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "value": 2,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Payments are processed in supported local currencies via authorized payment processors (including Lemon Squeezy / StartUp banking channels).",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "value": 3,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Condition of Sale: Software licenses are valid only upon receipt of full payment.",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            }
          ],
          "listType": "number",
          "direction": "ltr"
        },
        {
          "tag": "h3",
          "type": "heading",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "§ 7 Right of Withdrawal (Right to Cancel)",
              "type": "text",
              "version": 1
            }
          ],
          "direction": "ltr"
        },
        {
          "tag": "ol",
          "type": "list",
          "start": 1,
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "listitem",
              "value": 1,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "In accordance with Article 38(1)(13) of the Polish Consumer Rights Act, the right to withdraw from a distance contract within 14 days without giving any reason does not apply to contracts for the supply of digital content not supplied on a tangible medium, if the performance has begun with the Consumer's prior express consent and acknowledgment that they will lose their right of withdrawal.",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "value": 2,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "By requesting immediate delivery/access to MXGrid during checkout, the Customer acknowledges and agrees that they lose the statutory 14-day right of withdrawal once digital content delivery or license generation has commenced.",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            }
          ],
          "listType": "number",
          "direction": "ltr"
        },
        {
          "tag": "h3",
          "type": "heading",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "§ 8 Non-Conformity and Complaints (Warranty)",
              "type": "text",
              "version": 1
            }
          ],
          "direction": "ltr"
        },
        {
          "tag": "ol",
          "type": "list",
          "start": 1,
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "listitem",
              "value": 1,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "StartUp is obligated to deliver digital content that conforms to the Contract.",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "value": 2,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "If digital content (MXGrid) fails to conform to the contract or exhibits technical defects, the Customer may submit a complaint by sending an email to [email] or [email-rodo].",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "value": 3,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Complaints should include the order number, details of the Customer, and a description of the issue.",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "value": 4,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "StartUp will address and resolve complaints within 14 days of receipt, notifying the Customer on a durable medium (email).",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "value": 5,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "StartUp's liability for non-conformity or damages is limited to the purchase price of the product and excludes lost profits to the extent permitted by applicable law (except in cases involving Consumers).",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            }
          ],
          "listType": "number",
          "direction": "ltr"
        },
        {
          "tag": "h3",
          "type": "heading",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "§ 9 Intellectual Property",
              "type": "text",
              "version": 1
            }
          ],
          "direction": "ltr"
        },
        {
          "tag": "ol",
          "type": "list",
          "start": 1,
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "listitem",
              "value": 1,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "All software, code, UI design, trademarks, logos, and website content on mxbeats.com are protected by intellectual property laws and copyright.",
                  "type": "text",
                  "version": 1
