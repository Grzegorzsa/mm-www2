          "listType": "bullet",
          "direction": "ltr"
        },
        {
          "tag": "h3",
          "type": "heading",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "Managing and Withdrawing Consent",
              "type": "text",
              "version": 1
            }
          ],
          "direction": "ltr"
        },
        {
          "type": "paragraph",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "Some cookies are processed automatically upon visiting the website. You can manage, block, or withdraw consent for cookies at any time by modifying your web browser settings.",
              "type": "text",
              "version": 1
            }
          ],
          "direction": "ltr"
        },
        {
          "type": "paragraph",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "Instructions for managing cookies in popular browsers:",
              "type": "text",
              "version": 1
            }
          ],
          "direction": "ltr"
        },
        {
          "tag": "ul",
          "type": "list",
          "start": 1,
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "listitem",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Mozilla Firefox: https://support.mozilla.org/en-US/kb/clear-cookies-and-site-data-firefox",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Google Chrome: https://support.google.com/chrome/answer/95647",
                  "type": "text",
