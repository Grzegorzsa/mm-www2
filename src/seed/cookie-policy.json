                {
                  "text": "Microsoft Edge: https://support.microsoft.com/en-us/microsoft-edge/delete-cookies-in-microsoft-edge-63944251-1dd0-0b37-9808-77b480929e11",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Apple Safari: https://support.apple.com/guide/safari/manage-cookies-sfri11471/mac",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            }
          ],
          "listType": "bullet",
          "direction": "ltr"
        },
        {
          "type": "paragraph",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "Please note: Disabling or restricting cookies may result in incomplete or improper functioning of certain features on the website, although browsing will remain possible.",
              "type": "text",
              "version": 1
            }
          ],
          "direction": "ltr"
        },
        {
          "tag": "h3",
          "type": "heading",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "Contact and Rights",
              "type": "text",
              "version": 1
            }
          ],
          "direction": "ltr"
        },
        {
          "type": "paragraph",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "If you have any questions regarding data processing or wish to exercise your rights, you can contact us at: [email] or [email-rodo].",
              "type": "text",
              "version": 1
            }
          ],
          "direction": "ltr"
        },
        {
          "type": "paragraph",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "For full information regarding personal data processing and your statutory rights under the GDPR, please refer to our Privacy Policy: https://mxbeats.com/privacy-policy.",
              "type": "text",
              "version": 1
            }
          ],
          "direction": "ltr"
        },
        {
          "type": "paragraph",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "If you believe that data processing violates statutory regulations, you have the right to lodge a complaint with the supervisory authority (in Poland: the President of the Personal Data Protection Office - UODO, https://uodo.gov.pl/).",
              "type": "text",
              "version": 1
            }
          ],
          "direction": "ltr"
        }
      ],
      "direction": "ltr"
    }
