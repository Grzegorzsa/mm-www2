        {
          "tag": "h3",
          "type": "heading",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "What Are Cookies?",
              "type": "text",
              "version": 1
            }
          ],
          "direction": "ltr"
        },
        {
          "type": "paragraph",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "Cookies are small text files created automatically by web browsers when visiting or using websites. They are sent by the website and stored on the user's end device. Cookies allow the administrator to receive information that enables the website to function properly, ensures security, and improves user experience.",
              "type": "text",
              "version": 1
            }
          ],
          "direction": "ltr"
        },
        {
          "tag": "h3",
          "type": "heading",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "Types of Cookies We Use",
              "type": "text",
              "version": 1
            }
          ],
          "direction": "ltr"
        },
        {
          "type": "paragraph",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "We use the following types of cookies on our website:",
              "type": "text",
              "version": 1
            }
          ],
          "direction": "ltr"
        },
        {
          "tag": "ol",
          "type": "list",
          "start": 1,
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "listitem",
              "value": 1,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Essential / Technical Cookies: Necessary for the proper functioning of the website. These files are installed primarily to maintain user sessions, complete forms, and remember your cookie consent preferences.",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "value": 2,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Functional Cookies: Remember and adapt the platform to your choices (e.g., automatically filling in the email address from which you last logged in).",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "value": 3,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Analytical / Performance Cookies: Allow us to verify the number of visits and traffic sources. They help us identify which pages are popular and analyze performance statistics to improve our services.",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "value": 4,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Marketing Cookies: Used to tailor displayed content and advertisements to your interests on and off our portal. They may be set by advertising partners to build a profile of your interests based on your browsing activity.",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "value": 5,
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Social Media Cookies: Installed by third-party social media partners to display relevant advertising content on social media networks based on your interest profile.",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            }
          ],
          "listType": "number",
          "direction": "ltr"
        },
        {
          "tag": "h3",
          "type": "heading",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "text": "Cookie Storage Duration",
              "type": "text",
              "version": 1
            }
          ],
          "direction": "ltr"
        },
        {
          "tag": "ul",
          "type": "list",
          "start": 1,
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
            {
              "type": "listitem",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Session Cookies: Temporary files stored on your device until you leave the website or close your web browser.",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            },
            {
              "type": "listitem",
              "format": "",
              "indent": 0,
              "version": 1,
              "children": [
                {
                  "text": "Persistent Cookies: Stored on your device until they are manually deleted or reach their specified expiration date set in the browser settings.",
                  "type": "text",
                  "version": 1
                }
              ],
              "direction": "ltr"
            }
          ],
          "listType": "bullet",
          "direction": "ltr"
        },
        {
          "tag": "h3",
          "type": "heading",
          "format": "",
          "indent": 0,
          "version": 1,
          "children": [
